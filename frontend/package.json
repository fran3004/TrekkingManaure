{
  "name": "trekking-frontend",
  "description": "Sitio público del Trekking Desafío Perijá 13K.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "format": "prettier --write --ignore-path ../.prettierignore . ../admin ../shared ../docs ../README.md ../.prettierrc.json",
    "format:check": "prettier --check --ignore-path ../.prettierignore . ../admin ../shared ../docs ../README.md ../.prettierrc.json"
  },
  "dependencies": {
    "lenis": "^1.3.27",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@preact/preset-vite": "^2.10.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
