# Variables de Docker Compose. Copia este archivo a `.env` (no se versiona) y ajusta los valores:
#   cp .env.example .env

# Puerto del servidor desde el que se abre el sitio.
WEB_PORT=8081

# Variables VITE_*: se incrustan en el JavaScript al construir la imagen, así que son PÚBLICAS:
# no pongas secretos. Si las cambias, reconstruye: `docker compose build web`.
# Dirección pública de la API (obligatoria). En local: http://localhost:8080
VITE_API_URL=https://api.tudominio.com
VITE_CLOUDINARY_CLOUD_NAME=meoo7p5s
